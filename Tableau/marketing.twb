    <worksheet name='Top 10 Agents (Bookings vs. Revenue)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Bold'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='hotel_bookings_cleaned' name='federated.0vc3qua00twcrb178mn8201yg6bq' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Rank Agents By' datatype='string' name='[Babies Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Bookings&quot;'>
              <calculation class='tableau' formula='&quot;Bookings&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vc3qua00twcrb178mn8201yg6bq'>
            <column caption='booking revenue' datatype='real' name='[Calculation_1608632059097089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[adr] * ([stays_in_weekend_nights] + [stays_in_week_nights])' />
            </column>
            <column caption='Valid agent' datatype='boolean' name='[Calculation_1608632084447249]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[agent] &lt;&gt; 0' />
            </column>
            <column caption='agent filter' datatype='real' name='[Calculation_1608632086630418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Babies Parameter] = &quot;Bookings&quot; &#13;&#10;THEN COUNT([agent]) &#13;&#10;ELSE SUM([Calculation_1608632059097089]) &#13;&#10;END' />
            </column>
            <column caption='Metric Label' datatype='string' name='[Calculation_1608632088592403]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Babies Parameter] = &quot;Bookings&quot; THEN &quot;Total Bookings:&quot; ELSE &quot;Total Revenue: $&quot; END' />
            </column>
            <column caption='Adr' datatype='real' name='[adr]' role='measure' type='quantitative' />
            <column caption='Agent ID' datatype='integer' name='[agent]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1608632088592403]' derivation='Attribute' name='[attr:Calculation_1608632088592403:nk]' pivot='key' type='nominal' />
            <column-instance column='[adr]' derivation='Avg' name='[avg:adr:qk]' pivot='key' type='quantitative' />
            <column caption='Booking Changes' datatype='integer' name='[booking_changes]' role='measure' type='quantitative' />
            <column caption='Is Canceled' datatype='integer' name='[is_canceled]' role='measure' type='quantitative' />
            <column caption='Market Segment' datatype='string' name='[market_segment]' role='dimension' type='nominal' />
