      </column>
      <column caption='booking revenue' datatype='real' name='[Calculation_1608632059097089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[adr] * ([stays_in_weekend_nights] + [stays_in_week_nights])' />
      </column>
      <column caption='Is Canceled Flag' datatype='integer' name='[Calculation_1608632059400194]' role='measure' type='quantitative'>
