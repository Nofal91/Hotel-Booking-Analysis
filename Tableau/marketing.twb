      <column caption='Total Nights' datatype='integer' name='[Calculation_1608632058806272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[stays_in_weekend_nights] + [stays_in_week_nights]' />
      </column>
      <column caption='booking revenue' datatype='real' name='[Calculation_1608632059097089]' role='measure' type='quantitative'>
